{
  "name": "@dialectlabs/react-sdk",
  "version": "3.0.0-beta.6",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup-node --clean",
    "dev": "rm -rf dist && tsup-node --watch"
  },
  "devDependencies": {
    "@types/react": "^19",
    "tsup": "^8.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dialectlabs/react"
  },
  "dependencies": {
    "@dialectlabs/sdk": "2.0.0-beta.7",
    "swr": "^2.3.4"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
